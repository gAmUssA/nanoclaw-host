{
  "schema_version": 1,
  "protocol": "nanoclaw.learning-evidence-runtime.v1",
  "audience": "main",
  "transcripts": {
    "container_root": "/workspace/session-transcripts",
    "scope": "registered-current-group",
    "sessions": [
      "default",
      "maintenance"
    ],
    "readonly": true,
    "layout": "<group_folder>/<session_name>/<session_id>.jsonl",
    "source_subdirectory": "projects/-workspace-group",
    "sdk_alias_mask": "/workspace/project/data/sessions",
    "contract_path": "/workspace/session-transcripts/runtime.json"
  },
  "scanner": {
    "binary": "/usr/local/bin/gitleaks",
    "minimum_version": "8.30.1",
    "supported_major": 8,
    "image": {
      "repository": "ghcr.io/gitleaks/gitleaks",
      "pinning": "tag-and-sha256",
      "installation_repository": "jbaruch/nanoclaw",
      "installation_manifest": "container/Dockerfile",
      "installation_stage": "learning-secret-scanner"
    },
    "renewal": {
      "manager": "dependabot",
      "ecosystem": "docker",
      "directory": "/container",
      "schedule": "weekly"
    }
  }
}
